<launch>
    <arg name="agent_id" default="1"/>
    <arg name="agent_name" default="uav"/>
    <arg name="ip" default="0.0.0.0" />
    <!-- 向ROS全局参数空间中设置 /uav_id 与 /uav_name -->
    <param name="agent_id" type="int" value="$(arg agent_id)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <!-- 将mavros节点放置在 /uav_name+/uav_id 的命名空间下-->
    <group ns="$(arg agent_name)$(arg agent_id)">
        <arg name="fcu_url" default="/dev/ttyACM0:921600" />
        <arg name="gcs_url" default="udp://:14556@$(arg ip):14551" />
        <arg name="tgt_system" default="1" />
        <arg name="tgt_component" default="1" />
        <arg name="log_output" default="screen" />
        <arg name="fcu_protocol" default="v2.0" />
        <arg name="respawn_mavros" default="false" />

        <include file="$(find mavros)/launch/node.launch">
            <arg name="pluginlists_yaml" value="$(find sunray_mavros)/config/exp_px4_pluginlists.yaml" />
            <arg name="config_yaml" value="$(find sunray_mavros)/config/exp_px4_config.yaml" />
            <arg name="fcu_url" value="$(arg fcu_url)" />
            <arg name="gcs_url" value="$(arg gcs_url)" />
            <arg name="tgt_system" value="$(arg tgt_system)" />
            <arg name="tgt_component" value="$(arg tgt_component)" />
            <arg name="log_output" value="$(arg log_output)" />
            <arg name="fcu_protocol" value="$(arg fcu_protocol)" />
            <arg name="respawn_mavros" value="$(arg respawn_mavros)" />
        </include>
    </group>
</launch>
