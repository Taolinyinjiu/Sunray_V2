<launch>
    <arg name="config_path" default="$(find vins)/../config/sunray_150/sunray_nx_150.yaml" />
    <arg name="rviz_enable" default="false" />
    <node name="vins_estimator" pkg="vins" type="vins_node" output="screen" args="$(arg config_path)">
        </node>
    <node name="vins_visual" pkg="rviz" type="rviz" args="-d $(find vins)/../config/vins_rviz_config.rviz" if="$(arg rviz_enable)" />
</launch>
