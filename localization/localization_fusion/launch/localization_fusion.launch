<!-- 单机使用定位源启动文件，根据传入的参数source_id决定启动对应的定位源 -->
<launch>
    <!-- 使用的定位源配置 -->
    <!-- source_id 对应 localization_sources.yaml:
        0=VIOBOT, 1=MOCAP, 2=VINS, 3=GAZEBO, 4=GAZEBO_ARUCO,
        5=SUNRAY_SIM, 6=Fast_LIO, 7=Fast_LIO_EKF -->
    <arg name="source_id" default="3" />
    <!-- 使用的配置文件路径 -->
    <arg name="config_yamlfile_path" default="$(find localization_fusion)/config/localization_sources.yaml" />

    <!-- agent_name与agent_id 用于仿真环节或者特殊调试环节，指定智能体标识符 -->
    <arg name="agent_name" default="uav" />
    <arg name="agent_id" default="1" />
    <!-- 当use_private_agent_key为true时，定位融合localization_fusion节点使用上方定义的agent_name与agent_id组合智能体标识符，取代ROS参数空间中的标识符，通常建议在集群仿真中设置为true -->
    <arg name="use_private_agent_key" default="false" />
    
    <!-- 是否启动定位状态监视器，集群场景建议关闭并改用 swarm_monitor -->
    <arg name="enable_monitor" default="true" />
    <!-- 是否将 local_odom 转发为 MAVROS vision_pose，默认关闭 -->
    <arg name="enable_vision_pose" default="false" />
    <!-- 是否启动定位融合模块 RViz Marker 发布节点，该节点订阅OdomState话题，并转换为可视化对象 -->
    <arg name="enable_rviz_visualization" default="true" />
    
    <!-- 根据source_id 快速启动某个SLAM算法适配器或启动流程 -->

    <!-- source_id = 1, MOCAP 动捕里程计 -->
    <!-- source_id=1 时使用的动捕 VRPN 服务器地址 -->
    <arg name="vrpn_server" default="192.168.20.15" />
    <group if="$(eval int(arg('source_id')) == 1)">
        <include file="$(find localization_fusion)/source_launch/start_mocap.launch">
            <arg name="vrpn_server" value="$(arg vrpn_server)" />
        </include>
    </group>

    <!-- source_id = 6, Fast_LIO 里程计，原生10Hz输出 -->
    <group if="$(eval int(arg('source_id')) == 6)">
        <include file="$(find localization_fusion)/source_launch/start_fastlio_ekf.launch" >
            <arg name="ekf_enable" value="false" />
        </include>
    </group>

    <!-- source_id = 7, Fast_LIO 基于IMU数据做EKF预测更新的高频里程计，200Hz输出-->
    <group if="$(eval int(arg('source_id')) == 7)">
        <include file="$(find localization_fusion)/source_launch/start_fastlio_ekf.launch" />
    </group>

    <!-- ROS节点名，默认按 agent_name + agent_id 命名，例如 localization_fusion_uav1 -->
    <node pkg="localization_fusion" type="localization_fusion_node" name="$(arg agent_name)$(arg agent_id)_localization_fusion_node" output="screen">
        <param name="source_id" value="$(arg source_id)" />
        <param name="config_yamlfile_path" value="$(arg config_yamlfile_path)" />
        <param name="agent_name" value="$(arg agent_name)" />
        <param name="agent_id" value="$(arg agent_id)" />
        <param name="use_private_agent_key" value="$(arg use_private_agent_key)" />
    </node>

    <!-- 将 localization_fusion 的 local_odom 转发给 PX4 MAVROS vision_pose -->
    <arg name="vision_pose_local_odom_topic" default="/$(arg agent_name)$(arg agent_id)/sunray/localization/local_odom" />
    <arg name="vision_pose_topic" default="/$(arg agent_name)$(arg agent_id)/mavros/vision_pose/pose" />
    <node pkg="localization_fusion"
        type="local_odom_to_vision_pose_node"
        name="$(arg agent_name)$(arg agent_id)_local_odom_to_vision_pose"
        output="screen"
        if="$(arg enable_vision_pose)">
        <param name="local_odom_topic" value="$(arg vision_pose_local_odom_topic)" />
        <param name="vision_pose_topic" value="$(arg vision_pose_topic)" />
    </node>

    <!-- 定位模块输出状态监听节点 -->
    <node pkg="localization_fusion"
        type="localization_fusion_monitor_node"
        name="$(arg agent_name)$(arg agent_id)_localization_fusion_monitor"
        output="screen"
        if="$(arg enable_monitor)">
        <param name="agent_name" value="$(arg agent_name)" />
        <param name="source_id" value="$(arg source_id)" />
        <param name="config_yamlfile_path" value="$(arg config_yamlfile_path)" />
    </node>

    <!-- 定位模块 RViz Marker 发布节点，该节点订阅OdomState话题，并转换为可视化对象 -->
    <arg name="rviz_frame_id" default="world" />
    <arg name="localization_state_topic" default="/$(arg agent_name)$(arg agent_id)/sunray/localization/odom_state" />
    <arg name="localization_marker_topic" default="/$(arg agent_name)$(arg agent_id)/sunray/localization/rviz_markers" />
    <node pkg="localization_fusion"
        type="rviz_visualization_localization_fusion_node"
        name="$(arg agent_name)$(arg agent_id)_localization_fusion_rviz_visualization"
        output="screen"
        if="$(arg enable_rviz_visualization)">
        <param name="agent_name" value="$(arg agent_name)" />
        <param name="agent_id" value="$(arg agent_id)" />
        <param name="frame_id" value="$(arg rviz_frame_id)" />
        <param name="state_topic" value="$(arg localization_state_topic)" />
        <param name="marker_topic" value="$(arg localization_marker_topic)" />
    </node>
</launch>
