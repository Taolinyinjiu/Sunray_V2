<launch>
  <arg name="source_id" default="3" />
  <arg name="config_yamlfile_path" default="$(find localization_fusion)/config/localization_sources_ugv.yaml" />
  <arg name="health_rate_hz" default="10.0" />
  <arg name="use_receive_time" default="$(eval 'true' if int(arg('source_id')) == 3 else 'false')" />
  <arg name="agent_name" default="ugv" />
  <arg name="agent_id" default="1" />
  <arg name="use_private_agent_key" default="false" />
  <arg name="node_name" default="localization_fusion_ugv" />

  <arg name="global_frame_id" default="$(arg agent_name)$(arg agent_id)/sunray_global" />
  <arg name="local_frame_id" default="$(arg agent_name)$(arg agent_id)/sunray_local" />
  <arg name="base_frame_id" default="$(arg agent_name)$(arg agent_id)/base_link" />

  <node pkg="localization_fusion" type="localization_fusion_node" name="$(arg node_name)" output="screen">
    <param name="source_id" value="$(arg source_id)" />
    <param name="config_yamlfile_path" value="$(arg config_yamlfile_path)" />
    <param name="health_rate_hz" value="$(arg health_rate_hz)" />
    <param name="use_receive_time" value="$(arg use_receive_time)" />
    <param name="global_frame_id" value="$(arg global_frame_id)" />
    <param name="local_frame_id" value="$(arg local_frame_id)" />
    <param name="base_frame_id" value="$(arg base_frame_id)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" value="$(arg agent_id)" />
    <param name="use_private_agent_key" value="$(arg use_private_agent_key)" />
  </node>
</launch>
