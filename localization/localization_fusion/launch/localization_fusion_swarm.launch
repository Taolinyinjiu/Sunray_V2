<launch>
  <arg name="source_id" default="3" />
  <arg name="config_yamlfile_path"
       default="$(find localization_fusion)/config/localization_sources.yaml" />
  <arg name="health_rate_hz" default="10.0" />
  <arg name="use_receive_time" default="$(eval 'true' if int(arg('source_id')) == 3 else 'false')" />
  <arg name="log_enable" default="false" />
  <arg name="uav_name" default="uav" />
  <arg name="uav_id" default="1" />
  <arg name="uav_num" default="6" />

  <include file="$(find localization_fusion)/launch/localization_fusion.launch">
    <arg name="source_id" value="$(arg source_id)" />
    <arg name="config_yamlfile_path" value="$(arg config_yamlfile_path)" />
    <arg name="health_rate_hz" value="$(arg health_rate_hz)" />
    <arg name="use_receive_time" value="$(arg use_receive_time)" />
    <arg name="log_enable" value="$(arg log_enable)" />
    <arg name="uav_name" value="$(arg uav_name)" />
    <arg name="uav_id" value="$(arg uav_id)" />
    <arg name="node_name" value="$(eval 'localization_fusion_' + str(int(arg('uav_id'))))" />
    <arg name="set_global_params" value="false" />
    <arg name="test" value="false" />
  </include>

  <include file="$(find localization_fusion)/launch/localization_fusion_swarm.launch"
           if="$(eval int(arg('uav_num')) > int(arg('uav_id')))">
    <arg name="source_id" value="$(arg source_id)" />
    <arg name="config_yamlfile_path" value="$(arg config_yamlfile_path)" />
    <arg name="health_rate_hz" value="$(arg health_rate_hz)" />
    <arg name="use_receive_time" value="$(arg use_receive_time)" />
    <arg name="log_enable" value="$(arg log_enable)" />
    <arg name="uav_name" value="$(arg uav_name)" />
    <arg name="uav_id" value="$(eval int(arg('uav_id')) + 1)" />
    <arg name="uav_num" value="$(arg uav_num)" />
  </include>
</launch>
