<launch>
  <!-- UGV控制节点启动文件 -->
  <arg name="agent_name" default="ugv" />
  <arg name="agent_id" default="1" />
  <arg name="node_name" default="ugv_control_node" />
  <arg name="enable_monitor" default="true" />
  <arg name="enable_rviz_visualization" default="true" />
  <arg name="enable_rviz" default="false" />
  <arg name="enable_single_monitor" default="true" />
  <arg name="monitor_print_hz" default="2.0" />
  <arg name="monitor_stale_timeout" default="1.0" />
  <arg name="rviz_frame_id" default="world" />
  <arg name="rviz_config" default="$(find sunray_ugv_control)/rviz/ugv_control.rviz" />
  <arg name="ugv_control_state_topic" default="/$(arg agent_name)$(arg agent_id)/sunray/ugv_control/control_state" />
  <arg name="ugv_control_marker_topic" default="/$(arg agent_name)$(arg agent_id)/sunray/ugv_control/rviz_markers" />

  <!--
    为每台车创建独立参数作用域，避免 swarm launch 中多个 include 互相覆盖 agent_id / 配置参数。
    这里仅隔离参数；实际收发话题仍由程序内部按 /ugv1、/ugv2 ... 这样的绝对前缀生成。
  -->
  <group ns="$(arg node_name)_cfg">
    <!-- 加载配置文件 -->
    <rosparam file="$(find sunray_ugv_control)/config/ugv_control_config.yaml" />
    <param name="agent_name" type="str" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="$(arg agent_id)" />

    <!-- 启动UGV控制节点 -->
    <node pkg="sunray_ugv_control" type="node" name="$(arg node_name)" output="screen" />

    <!-- 可选：终端状态面板，订阅 UGVControlState 打印控制状态 -->
    <node if="$(arg enable_single_monitor)"
          pkg="sunray_ugv_control"
          type="ugv_control_monitor_node"
          name="$(arg agent_name)$(arg agent_id)_ugv_control_monitor"
          output="screen">
      <param name="agent_name" type="str" value="$(arg agent_name)" />
      <param name="agent_num" type="int" value="1" />
      <param name="print_hz" value="$(arg monitor_print_hz)" />
      <param name="stale_timeout" value="$(arg monitor_stale_timeout)" />
    </node>

    <!-- 可选：发布 UGVControlState 对应的 RViz Marker -->
    <node if="$(arg enable_rviz_visualization)"
          pkg="sunray_ugv_control"
          type="rviz_visualization_ugv_control_node"
          name="$(arg agent_name)$(arg agent_id)_ugv_control_rviz_visualization"
          output="screen">
      <param name="agent_name" type="str" value="$(arg agent_name)" />
      <param name="agent_id" type="int" value="$(arg agent_id)" />
      <param name="frame_id" value="$(arg rviz_frame_id)" />
      <param name="state_topic" value="$(arg ugv_control_state_topic)" />
      <param name="marker_topic" value="$(arg ugv_control_marker_topic)" />
    </node>

    <!-- 可选：启动 RViz GUI。SSH/无图形环境下建议保持 false。 -->
    <node if="$(arg enable_rviz)"
          pkg="rviz"
          type="rviz"
          name="$(arg agent_name)$(arg agent_id)_ugv_control_rviz"
          args="-d $(arg rviz_config)"
          output="screen" />
  </group>
</launch>
