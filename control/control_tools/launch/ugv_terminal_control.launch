<launch>
  <!-- UGV 终端控制工具：发布到 /<agent_name><agent_id>/sunray/ugv_control/control_cmd -->
  <arg name="agent_name" default="ugv" />
  <arg name="agent_id" default="1" />
  <arg name="node_name" default="ugv_terminal_control_node" />
  <arg name="launch_prefix" default="" />

  <node pkg="control_tools"
        type="ugv_terminal_control_node"
        name="$(arg node_name)"
        output="screen"
        launch-prefix="$(arg launch_prefix)">
    <param name="agent_name" type="str" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="$(arg agent_id)" />
  </node>
</launch>
