<?xml version="1.0"?>
<package format="2">
  <name>sunray_flight_logger</name>
  <version>0.1.0</version>
  <description>Terminal UI for browsing, downloading and deleting PX4 flight logs through MAVROS FTP.</description>

  <maintainer email="sirui@yundrone.com">YunDrone Tech</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>roslib</build_depend>
  <build_depend>mavros_msgs</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>roslib</build_export_depend>
  <build_export_depend>mavros_msgs</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>sunray_mavros</exec_depend>

  <export/>
</package>
