<launch>
    <!--
      sunray_sim 的唯一启动入口。

      本 launch 只启动一个 ROS node：sunray_sim_node。
      该 node 在同一个进程内创建这些模块：
        1. SingleUavSimulator：无人机仿真管理层，每个 uav.agent_id 创建一套本机模块。
        2. SingleUgvSimulator：无人车仿真管理层，每个 ugv.agent_id 创建一套本机模块。
        3. GlobalMapServer：enable_sensing=true 时读取 PCD，发布全局点云。
        4. LocalMid360Simulator：enable_sensing=true 时基于全局地图和 odom 生成 MID360 风格局部点云。
        5. UavPlant：订阅电机 RPM，发布 odom / imu / navsat。
        6. Px4MavrosSim：订阅 MAVROS setpoint，转换成电机 RPM，并发布 fake MAVROS 话题/服务。
        7. UgvPlant：订阅 UGV cmd_vel，发布 UGV odom / imu。
        8. SimVisualizer：订阅仿真状态，发布一个 RViz MarkerArray 可视化话题。

      常用 topic：
        /sunray_sim/global_cloud
        ~/sunray_sim/odom
        ~/sunray_sim/imu
        ~/sunray_sim/cloud_world_frame
        ~/sunray_sim/cloud_sensor_frame
        ~/sunray_sim/visualization
        ~/mavros/state
        ~/mavros/local_position/odom
        ~/mavros/local_position/pose
        ~/mavros/local_position/velocity_local
        ~/mavros/global_position/global
        ~/mavros/gpsstatus/gps1/raw
        ~/mavros/imu/data
    -->

    <!--
      配置文件分为两层，并使用完全一致的加载方式：
        <rosparam file="$(arg xxx_config)" command="load" subst_value="true" />

      subst_value="true" 允许 YAML 中使用 $(find sunray_sim) 这样的 roslaunch
      替换语法。所有文件都会加载到 sunray_sim_node 的私有参数空间。

      参数归属：
        scenario_config:
          读取模块：sunray_sim_node
          内容：当前仿真场景，包括启动 UAV/UGV、agent_ids、global_frame_id、
                enable_sensing、状态打印和 vehicles 初始位姿。
          常用场景：
                uav_single.yaml：默认单 UAV。
                uav_swarm6.yaml：6 机 UAV 集群。
                ugv_single.yaml：单 UGV。
                ugv_swarm6.yaml：6 车 UGV 集群。
          其中 enable_sensing 控制是否启动 GlobalMapServer 和 LocalMid360Simulator；
          vehicles/<agent>/init_* 会被 SingleUavSimulator/SingleUgvSimulator 读取。
          注意：global_frame_id 是全包共享参数，会被 GlobalMapServer、
                LocalMid360Simulator、UavPlant 同时读取，用于统一全局地图、
                局部点云、TF、odom 和 navsat 的全局坐标系。

        global_map_server_config:
          读取模块：GlobalMapServer
          内容：PCD 地图路径、全局点云话题、降采样、地图偏移。

        local_mid360_simulator_config:
          读取模块：LocalMid360Simulator
          内容：MID360 局部点云视场、量程、角分辨率、发布频率和 sensor frame。

        uav_plant_config:
          读取模块：UavPlant；其中质量/重力/机臂/电机关键参数也会被
                Px4MavrosSim 读取，用于 setpoint 转 RPM。
          内容：动力学频率、控制超时、机体 frame、刚体参数、电机参数。

        imu_model_config:
          读取模块：UavPlant 内部的 sunray_imu_sim::ImuModel
          内容：IMU preset、bias、噪声、协方差、安装误差、时间异步。

        px4_mavros_sim_config:
          读取模块：Px4MavrosSim
          内容：PX4 setpoint 转 RPM 的 PID/限幅、控制更新频率、fake MAVROS
                发布频率、初始 armed/mode 状态和电池状态。

        ugv_plant_config:
          读取模块：UgvPlant
          内容：UGV 底盘类型、速度/加速度限幅、cmd_vel 超时、odom 协方差和发布频率。

        sim_visualizer_config:
          读取模块：sunray_sim_node、SimVisualizer
          内容：是否启用可视化、MarkerArray 话题、发布频率、UAV/UGV 显示大小、
                轨迹长度、速度箭头和状态文字开关。UAV 显示为 X 型四旋翼，
                UGV 显示为矩形车体和四轮小车。
    -->
    <!--
      常用场景配置文件名。用户通常只需要改这个参数，例如：
        roslaunch sunray_sim sunray_sim.launch scenario_config_file:=uav_swarm6.yaml
      不建议在命令行参数中写 $(find sunray_sim)，因为启动器/终端会先把 $(...) 当成 shell 命令替换。
    -->
    <arg name="scenario_config_file" default="uav_single.yaml" />

    <arg name="scenario_config" default="$(find sunray_sim)/config/$(arg scenario_config_file)" />
    <arg name="global_map_server_config" default="$(find sunray_sim)/config/modules/global_map_server.yaml" />
    <arg name="local_mid360_simulator_config" default="$(find sunray_sim)/config/modules/local_mid360_simulator.yaml" />
    <arg name="uav_plant_config" default="$(find sunray_sim)/config/modules/uav_plant.yaml" />
    <arg name="imu_model_config" default="$(find sunray_sim)/config/modules/imu_model.yaml" />
    <arg name="px4_mavros_sim_config" default="$(find sunray_sim)/config/modules/px4_mavros_sim.yaml" />
    <arg name="ugv_plant_config" default="$(find sunray_sim)/config/modules/ugv_plant.yaml" />
    <arg name="sim_visualizer_config" default="$(find sunray_sim)/config/modules/sim_visualizer.yaml" />

    <!-- 是否额外启动 RViz。true 时启动默认 RViz 配置，方便直接观察地图、局部点云和车辆 marker。 -->
    <arg name="rviz" default="true" />
    <arg name="rviz_config" default="$(find sunray_sim)/rviz/sunray_sim.rviz" />

    <!--
      唯一 node。

      如果同名参数在多个 YAML 中出现，后加载的文件覆盖先加载的文件。
      默认配置已按模块拆分，正常情况下不需要依赖覆盖关系。
    -->
    <node name="sunray_sim_node"
          pkg="sunray_sim"
          type="sunray_sim_node"
          output="screen">
        <rosparam file="$(arg scenario_config)" command="load" subst_value="true" />
        <rosparam file="$(arg global_map_server_config)" command="load" subst_value="true" />
        <rosparam file="$(arg local_mid360_simulator_config)" command="load" subst_value="true" />
        <rosparam file="$(arg uav_plant_config)" command="load" subst_value="true" />
        <rosparam file="$(arg imu_model_config)" command="load" subst_value="true" />
        <rosparam file="$(arg px4_mavros_sim_config)" command="load" subst_value="true" />
        <rosparam file="$(arg ugv_plant_config)" command="load" subst_value="true" />
        <rosparam file="$(arg sim_visualizer_config)" command="load" subst_value="true" />
    </node>

    <!--
      可选 RViz。
      默认自动启动，方便直接查看仿真效果；无图形环境或一键脚本不需要 RViz 时：
        roslaunch sunray_sim sunray_sim.launch rviz:=false
    -->
    <node if="$(arg rviz)"
          name="sunray_sim_rviz"
          pkg="rviz"
          type="rviz"
          args="-d $(arg rviz_config)"
          output="screen" />
</launch>
