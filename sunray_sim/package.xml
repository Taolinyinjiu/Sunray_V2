<?xml version="1.0"?>
<package format="2">
  <name>sunray_sim</name>
  <version>0.1.0</version>
  <description>Sunray lightweight numerical simulator with PCD map, local MID360 cloud, UAV/UGV dynamics, odometry, IMU, fake MAVROS outputs, and RViz visualization.</description>

  <maintainer email="amov@todo.todo">amov</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rospkg</exec_depend>

  <export>
  </export>
</package>
