<?xml version="1.0" ?>
<package format="2">
  <name>sunray_ugv_control_example</name>
  <version>0.1.0</version>
  <description>Example control nodes for learning the Sunray UGV control command interface.</description>

  <maintainer email="yundrone@yundrone.cn">YunDrone Tech</maintainer>
  <license>MPL-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sunray_msgs</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>sunray_msgs</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sunray_msgs</exec_depend>

  <export>
  </export>
</package>
