<launch>
  <!-- swarm_control 单机启动文件，直接选择 UAV 或 UGV 专用节点 -->
  <!-- 可调参数范围：agent_id >=1，agent_num >=1 -->
  <!-- formation_policy: keep_formation 表示不在启动时指定阵型；spacing > 0 -->
  <!-- use_fixed_altitude: true/false；fixed_altitude > 0 -->
  <!-- goal_z_tolerance: 到位判定的 Z 误差容差 (m)，仅 UAV 有效 -->
  <!-- orca_timeout: 秒；rate 参数建议 5~50 -->
  <!-- ORCA 参数已并入本 launch，由专用 swarm 节点内部直接初始化 -->
  
  <arg name="agent_id" default="1"/>
  <arg name="agent_num" default="1"/>
  <arg name="agent_type" default="0"/>
  <arg name="agent_name" default="uav"/>
  <arg name="formation_policy" default="keep_formation"/>
  <arg name="spacing" default="1.0"/>
  <arg name="spacing_min" default="0.3"/>
  <arg name="spacing_max" default="5.0"/>
  <arg name="spacing_scale_up" default="1.2"/>
  <arg name="spacing_scale_down" default="0.8"/>
  <arg name="use_fixed_altitude" default="true"/>
  <arg name="fixed_altitude" default="1.0"/>
  <arg name="orca_timeout" default="1.0"/>
  <arg name="goal_rate" default="20.0"/>
  <arg name="control_rate" default="20.0"/>
  <arg name="state_pub_rate" default="20.0"/>
  <arg name="virtual_leader_x" default="0.0"/>
  <arg name="virtual_leader_y" default="0.0"/>
  <arg name="virtual_leader_z" default="1.0"/>
  <arg name="virtual_leader_yaw" default="0.0"/>
  <arg name="goal_z_tolerance" default="0.2"/>
  <arg name="neighborDist" default="3.0"/>
  <arg name="timeHorizon" default="2.0"/>
  <arg name="timeHorizonObst" default="2.0"/>
  <arg name="radius" default="0.3"/>
  <arg name="maxSpeed" default="2.0"/>
  <arg name="time_step" default="0.2"/>
  <arg name="geo_min_x" default="-20.0"/>
  <arg name="geo_max_x" default="20.0"/>
  <arg name="geo_min_y" default="-20.0"/>
  <arg name="geo_max_y" default="20.0"/>
  <arg name="node_executable" default="uav_swarm_node"/>
  <arg name="node_name" default="uav_swarm_node"/>

  <node pkg="sunray_swarm_control" type="$(arg node_executable)" name="$(arg node_name)" output="screen">
    <param name="agent_id" value="$(arg agent_id)"/>
    <param name="agent_num" value="$(arg agent_num)"/>
    <param name="agent_type" value="$(arg agent_type)"/>
    <param name="agent_name" value="$(arg agent_name)"/>
    <param name="formation_policy" value="$(arg formation_policy)"/>
    <param name="spacing" value="$(arg spacing)"/>
    <param name="spacing_min" value="$(arg spacing_min)"/>
    <param name="spacing_max" value="$(arg spacing_max)"/>
    <param name="spacing_scale_up" value="$(arg spacing_scale_up)"/>
    <param name="spacing_scale_down" value="$(arg spacing_scale_down)"/>
    <param name="use_fixed_altitude" value="$(arg use_fixed_altitude)"/>
    <param name="fixed_altitude" value="$(arg fixed_altitude)"/>
    <param name="orca_timeout" value="$(arg orca_timeout)"/>
    <param name="goal_rate" value="$(arg goal_rate)"/>
    <param name="control_rate" value="$(arg control_rate)"/>
    <param name="state_pub_rate" value="$(arg state_pub_rate)"/>
    <param name="virtual_leader_x" value="$(arg virtual_leader_x)"/>
    <param name="virtual_leader_y" value="$(arg virtual_leader_y)"/>
    <param name="virtual_leader_z" value="$(arg virtual_leader_z)"/>
    <param name="virtual_leader_yaw" value="$(arg virtual_leader_yaw)"/>
    <param name="goal_z_tolerance" value="$(arg goal_z_tolerance)"/>
    <param name="orca_params/neighborDist" value="$(arg neighborDist)"/>
    <param name="orca_params/timeHorizon" value="$(arg timeHorizon)"/>
    <param name="orca_params/timeHorizonObst" value="$(arg timeHorizonObst)"/>
    <param name="orca_params/radius" value="$(arg radius)"/>
    <param name="orca_params/maxSpeed" value="$(arg maxSpeed)"/>
    <param name="orca_params/time_step" value="$(arg time_step)"/>
    <param name="geo_fence/min_x" value="$(arg geo_min_x)"/>
    <param name="geo_fence/max_x" value="$(arg geo_max_x)"/>
    <param name="geo_fence/min_y" value="$(arg geo_min_y)"/>
    <param name="geo_fence/max_y" value="$(arg geo_max_y)"/>
  </node>
</launch>
