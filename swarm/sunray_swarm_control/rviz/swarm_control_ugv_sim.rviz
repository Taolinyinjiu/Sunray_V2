      Namespaces:
        static_obstacles: true
        ugv_1: true
        ugv_2: true
        ugv_3: true
        ugv_4: true
        ugv_5: true
        ugv_6: true
        world_origin: true
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 18; 18
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 15.908824920654297
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 2.897374391555786
        Y: -0.7701141834259033
        Z: 2.3542866706848145
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.1597968339920044
      Target Frame: <Fixed Frame>
      Yaw: 3.0115911960601807
    Saved: ~
