<launch>
  <!--
    仿真模式下批量启动多个 swarm_control_ugv_node。
    使用方式示例：
      roslaunch sunray_swarm_control swarm_control_ugv_sim.launch
      roslaunch sunray_swarm_control swarm_control_ugv_sim.launch swarm_num:=6
  -->

  <arg name="swarm_num" default="3" />
  <arg name="agent_name" default="ugv" />
  <arg name="param_file" default="$(find sunray_swarm_control)/launch/swarm_control_ugv_sim.yaml" />
  <arg name="node_output" default="screen" />
  <arg name="enable_rviz_visualization" default="true" />
  <arg name="rviz_frame_id" default="world" />
  <arg name="rviz_marker_topic" default="/sunray/swarm/ugv_rviz_markers" />
  <arg name="rviz_mesh_resource" default="package://sunray_swarm_control/utils/meshes/ugv.dae" />
  <arg name="enable_rviz" default="true" />
  <arg name="rviz_config" default="$(find sunray_swarm_control)/rviz/swarm_control_ugv_sim.rviz" />
  <arg name="enable_monitor" default="true" />
  <arg name="monitor_clear_screen" default="true" />

  <!--
    当前显式展开到 10 辆无人车：
    1. 便于直接查看 launch 文件结构；
    2. 与 formation 当前常用 1-10 个智能体规模保持一致；
    3. 实际启动数量由 swarm_num 控制。
  -->

  <node if="$(eval int(arg('swarm_num')) >= 1)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)1_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="1" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 2)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)2_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="2" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 3)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)3_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="3" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 4)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)4_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="4" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 5)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)5_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="5" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 6)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)6_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="6" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 7)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)7_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="7" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 8)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)8_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="8" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 9)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)9_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="9" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(eval int(arg('swarm_num')) >= 10)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_node"
        name="$(arg agent_name)10_swarm_control"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="10" />
    <param name="swarm_num" type="int" value="$(arg swarm_num)" />
  </node>

  <node if="$(arg enable_rviz_visualization)"
        pkg="sunray_swarm_control"
        type="rviz_visualization_ugv_node"
        name="rviz_visualization_ugv"
        output="$(arg node_output)">
    <rosparam command="load" file="$(arg param_file)" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="swarm_state_topic" value="/sunray/swarm/ugv_swarm_state" />
    <param name="marker_topic" value="$(arg rviz_marker_topic)" />
    <param name="frame_id" value="$(arg rviz_frame_id)" />
    <param name="mesh_resource" value="$(arg rviz_mesh_resource)" />
    <param name="publish_hz" value="10.0" />
    <param name="stale_timeout" value="1.0" />
    <param name="trail_size" value="50" />
    <param name="mesh_scale" value="1.0" />
    <param name="velocity_scale" value="1.0" />
    <param name="text_height" value="0.28" />
  </node>

  <node if="$(arg enable_monitor)"
        pkg="sunray_swarm_control"
        type="swarm_control_ugv_monitor_node"
        name="swarm_control_ugv_monitor"
        output="screen">
    <param name="swarm_state_topic" value="/sunray/swarm/ugv_swarm_state" />
    <param name="agent_name" value="$(arg agent_name)" />
    <param name="display_hz" value="1.0" />
    <param name="stale_timeout" value="1.0" />
    <param name="clear_screen" value="$(arg monitor_clear_screen)" />
  </node>

  <node if="$(arg enable_rviz)"
        pkg="rviz"
        type="rviz"
        name="swarm_control_ugv_rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>
