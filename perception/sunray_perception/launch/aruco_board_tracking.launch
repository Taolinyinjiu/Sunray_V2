<launch>
  <arg name="camera_config_path" default="$(find sunray_perception)/config/camera/usb_camera.yaml" />
  <arg name="tracking_config_path" default="$(find sunray_perception)/config/tracking/aruco_board_tracking.yaml" />

  <node pkg="sunray_perception" type="tracking_node" name="aruco_board_tracking" output="screen">
    <param name="tracker_type" value="aruco_board" />
    <param name="camera_config_path" value="$(arg camera_config_path)" />
    <param name="tracking_config_path" value="$(arg tracking_config_path)" />
  </node>
</launch>
