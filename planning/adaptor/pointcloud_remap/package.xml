<?xml version="1.0" ?>
<package format="2">
  <name>pointcloud_remap</name>
  <version>0.0.0</version>
  <description>Point cloud transformation and remapping node for converting sensor point clouds to world frame</description>

  <maintainer email="taolin@todo.todo">taolin</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>roscpp</depend>
  <depend>std_msgs</depend>

  <!-- Message dependencies -->
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- PCL dependencies -->
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>

  <!-- TF dependencies for coordinate transforms -->
  <depend>tf2</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <export />
</package>
