<launch>
  <!-- 地图尺寸与局部更新范围 -->
  <arg name="map_size_x" default="5.5"/>
  <arg name="map_size_y" default="5.5"/>
  <arg name="map_size_z" default="4.5"/>
  <arg name="local_map_size_x" default="5.5"/>
  <arg name="local_map_size_y" default="5.5"/>
  <arg name="local_map_size_z" default="4.5"/>

  <!-- 感知输入 -->
  <arg name="odom_topic"/>
  <arg name="camera_pose_topic" default="no_use0"/>
  <arg name="depth_topic" default="no_use1"/>
  <arg name="cloud_topic" default="no_use2"/>
  <arg name="extrinsic_topic" default="no_use3"/>

  <!-- 深度相机内参 -->
  <arg name="cx" default="0.0"/>
  <arg name="cy" default="0.0"/>
  <arg name="fx" default="0.0"/>
  <arg name="fy" default="0.0"/>

  <!-- 规划器约束 -->
  <arg name="max_vel" default="0.5"/>
  <arg name="max_acc" default="3.0"/>
  <arg name="max_jerk" default="4.0"/>
  <arg name="planning_horizon" default="5.0"/>
  <arg name="map_resolution" default="0.12"/>
  <arg name="inflation_size" default="0.09"/>
  <arg name="virtual_ceil" default="3.0"/>
  <arg name="virtual_ground" default="0.1"/>
  <arg name="traj_server_time_forward" default="1.0"/>


  <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen">
    <param name="planner_config/odom_topic" value="$(arg odom_topic)"/>
    <param name="planner_config/pose_topic" value="$(arg camera_pose_topic)"/>
    <param name="planner_config/depth_topic" value="$(arg depth_topic)"/>
    <param name="planner_config/cloud_topic" value="$(arg cloud_topic)"/>
    <param name="planner_config/extrinsic_topic" value="$(arg extrinsic_topic)"/>

    <!-- planning fsm -->
    <!-- 1 EXTERNAL_TARGET: 从 Sunray planner_interface 转发目标点 -->
    <!-- 2 PRESET_TARGET: 使用预设航点 -->
    <param name="fsm/flight_type" value="1" type="int"/>
    <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
    <param name="fsm/thresh_no_replan_meter" value="1.0" type="double"/>
    <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <param name="fsm/planning_horizen_time" value="3" type="double"/>
    <param name="fsm/emergency_time" value="1.0" type="double"/>
    <param name="fsm/realworld_experiment" value="true"/>
    <param name="fsm/fail_safe" value="true"/>
    <param name="fsm/fix_agent_height" value="false" type="bool"/>
    <param name="fsm/agent_height" value="1.0" type="double"/>
    <param name="fsm/waypoint_num" value="0" type="int"/>

    <!-- GridMap -->
    <param name="grid_map/resolution" value="$(arg map_resolution)"/>
    <param name="grid_map/map_size_x" value="$(arg map_size_x)"/>
    <param name="grid_map/map_size_y" value="$(arg map_size_y)"/>
    <param name="grid_map/map_size_z" value="$(arg map_size_z)"/>
    <param name="grid_map/local_update_range_x" value="$(arg local_map_size_x)"/>
    <param name="grid_map/local_update_range_y" value="$(arg local_map_size_y)"/>
    <param name="grid_map/local_update_range_z" value="$(arg local_map_size_z)"/>
    <param name="grid_map/obstacles_inflation" value="$(arg inflation_size)"/>
    <param name="grid_map/virtual_ceil_height" value="$(arg virtual_ceil)"/>
    <param name="grid_map/virtual_ceil_yp" value="-0.1" type="double"/>
    <param name="grid_map/virtual_ceil_yn" value="-0.1" type="double"/>
    <param name="grid_map/ground_height" value="$(arg virtual_ground)"/>
    <param name="grid_map/local_map_margin" value="10"/>
    <param name="grid_map/visualization_truncate_height" value="1.9"/>
    <param name="grid_map/show_occ_time" value="false"/>
    <param name="grid_map/pose_type" value="1"/>
    <param name="grid_map/frame_id" value="world"/>
    <param name="grid_map/odom_depth_timeout" value="1.0" type="double"/>

    <!-- camera parameter -->
    <param name="grid_map/cx" value="$(arg cx)"/>
    <param name="grid_map/cy" value="$(arg cy)"/>
    <param name="grid_map/fx" value="$(arg fx)"/>
    <param name="grid_map/fy" value="$(arg fy)"/>

    <!-- depth filter -->
    <param name="grid_map/use_depth_filter" value="true"/>
    <param name="grid_map/depth_filter_tolerance" value="0.15"/>
    <param name="grid_map/depth_filter_maxdist" value="5.0"/>
    <param name="grid_map/depth_filter_mindist" value="0.2"/>
    <param name="grid_map/depth_filter_margin" value="2"/>
    <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
    <param name="grid_map/skip_pixel" value="2"/>

    <!-- local fusion -->
    <param name="grid_map/p_hit" value="0.65"/>
    <param name="grid_map/p_miss" value="0.35"/>
    <param name="grid_map/p_min" value="0.12"/>
    <param name="grid_map/p_max" value="0.90"/>
    <param name="grid_map/p_occ" value="0.80"/>
    <param name="grid_map/min_ray_length" value="0.1"/>
    <param name="grid_map/max_ray_length" value="4.5"/>

    <!-- planner manager -->

    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="manager/max_jerk" value="$(arg max_jerk)" type="double"/>
    <param name="manager/control_points_distance" value="0.4" type="double"/>
    <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
    <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <param name="manager/use_distinctive_trajs" value="true" type="bool"/>
    <param name="manager/fix_height" value="false" type="bool"/>
    <param name="manager/fixed_height" value="0.5" type="double"/>

    <!-- B 样条优化 -->
    <param name="optimization/lambda_smooth" value="2.0" type="double"/>
    <param name="optimization/lambda_collision" value="0.5" type="double"/>
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <param name="optimization/dist0" value="0.5" type="double"/>
    <param name="optimization/swarm_clearance" value="0.5" type="double"/>
    <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="optimization/order" value="3" type="int"/>
  </node>

  <node pkg="ego_planner" name="traj_server" type="traj_server" output="screen">
    <param name="planner_config/odom_topic" value="$(arg odom_topic)"/>
    <param name="planner_config/pose_topic" value="$(arg camera_pose_topic)"/>
    <param name="planner_config/depth_topic" value="$(arg depth_topic)"/>
    <param name="planner_config/cloud_topic" value="$(arg cloud_topic)"/>
    <param name="planner_config/extrinsic_topic" value="$(arg extrinsic_topic)"/>
    <param name="traj_server/time_forward" value="$(arg traj_server_time_forward)" type="double"/>
    <param name="traj_server/yaw_rate_max" value="1.57079632679" type="double"/>
    <param name="traj_server/yaw_acc_max" value="3.14159265359" type="double"/>
    <param name="traj_server/target_yaw_rate_max" value="2.09439510239" type="double"/>
    <param name="traj_server/target_yaw_filter_time_constant" value="0.15" type="double"/>
    <param name="traj_server/yaw_dir_min_norm" value="0.1" type="double"/>
    <param name="traj_server/start_yaw_enter_thresh" value="0.523598775598" type="double"/>
    <param name="traj_server/start_yaw_exit_thresh" value="0.13962634016" type="double"/>
    <param name="traj_server/end_yaw_thresh" value="0.0872664625997" type="double"/>
    <param name="traj_server/start_yaw_timeout" value="0.6" type="double"/>
  </node>
</launch>