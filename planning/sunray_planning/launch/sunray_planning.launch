<launch>
  <arg name="planner_type" default="ego" />
  <arg name="uav_name" default="uav" />
  <arg name="uav_id" default="1" />
  <arg name="node_name" default="sunray_planning_node" />
  <arg name="set_global_params" default="true" />
  <arg name="planning_cmd_sub_topic" default="/$(arg uav_name)$(arg uav_id)/sunray/planning_cmd" />
  <arg name="control_pub_topic" default="/$(arg uav_name)$(arg uav_id)/sunray/uav_control_cmd" />
  <arg name="planning_state_pub_topic" default="/$(arg uav_name)$(arg uav_id)/sunray/planning_state" />
  <arg name="control_fsm_state_sub_topic" default="/$(arg uav_name)$(arg uav_id)/sunray/fsm/state" />
  <arg name="process_rate_hz" default="50.0" />
  <arg name="state_pub_rate_hz" default="10.0" />
  <arg name="auto_hover_on_timeout" default="true" />
  <arg name="control_fsm_state_timeout_sec" default="1.0" />
  <arg name="follow_control_fsm" default="true" />
  <arg name="log_save" default="false" />

  <param if="$(arg set_global_params)" name="/uav_name" value="$(arg uav_name)" />
  <param if="$(arg set_global_params)" name="/uav_id" value="$(arg uav_id)" />

  <node pkg="sunray_planning"
        type="sunray_planning_node"
        name="$(arg node_name)"
        output="screen">
    <param name="planner_type" value="$(arg planner_type)" />
    <param name="uav_name" value="$(arg uav_name)" />
    <param name="uav_id" value="$(arg uav_id)" />
    <param name="planning_cmd_sub_topic" value="$(arg planning_cmd_sub_topic)" />
    <param name="control_pub_topic" value="$(arg control_pub_topic)" />
    <param name="planning_state_pub_topic" value="$(arg planning_state_pub_topic)" />
    <param name="control_fsm_state_sub_topic" value="$(arg control_fsm_state_sub_topic)" />
    <param name="process_rate_hz" value="$(arg process_rate_hz)" />
    <param name="state_pub_rate_hz" value="$(arg state_pub_rate_hz)" />
    <param name="auto_hover_on_timeout" value="$(arg auto_hover_on_timeout)" />
    <param name="control_fsm_state_timeout_sec" value="$(arg control_fsm_state_timeout_sec)" />
    <param name="follow_control_fsm" value="$(arg follow_control_fsm)" />
    <param name="log_save" value="$(arg log_save)" />
  </node>
</launch>
