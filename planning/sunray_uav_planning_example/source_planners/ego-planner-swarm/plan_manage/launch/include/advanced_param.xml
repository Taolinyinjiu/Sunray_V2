<launch>
  <!-- 无人机编号，EGO planner 内部使用从 0 开始的 drone_id。 -->
  <arg name="drone_id" default="0"/>
  <!-- 全局地图在 x 方向的尺寸，单位为米。 -->
  <arg name="map_size_x" default="50.0"/>
  <!-- 全局地图在 y 方向的尺寸，单位为米。 -->
  <arg name="map_size_y" default="25.0"/>
  <!-- 全局地图在 z 方向的尺寸，单位为米。 -->
  <arg name="map_size_z" default="2.0"/>
  <!-- 局部地图在 x 方向的更新范围，单位为米。 -->
  <arg name="local_update_range_x" default="5.5"/>
  <!-- 局部地图在 y 方向的更新范围，单位为米。 -->
  <arg name="local_update_range_y" default="5.5"/>
  <!-- 局部地图在 z 方向的更新范围，单位为米。 -->
  <arg name="local_update_range_z" default="4.5"/>

  <!-- 里程计输入话题，供 FSM 和地图模块获取机器人状态。 -->
  <arg name="odom_topic"/>
  <!-- 相机位姿输入话题，深度建图模式下使用。 -->
  <arg name="camera_pose_topic" default="no_use_pose"/>
  <!-- 深度图输入话题，VIO/深度相机场景使用。 -->
  <arg name="depth_topic" default="no_use_depth"/>
  <!-- 点云输入话题，LIO/点云建图场景使用。 -->
  <arg name="cloud_topic" default="no_use_cloud"/>
  <!-- RViz 目标点输入话题，默认对应 RViz 的 2D Nav Goal。 -->
  <arg name="goal_name" default="/move_base_simple/goal"/>

  <!-- 深度相机主点 x 坐标，深度图输入模式使用。 -->
  <arg name="cx" default="0.0"/>
  <!-- 深度相机主点 y 坐标，深度图输入模式使用。 -->
  <arg name="cy" default="0.0"/>
  <!-- 深度相机 x 方向焦距，深度图输入模式使用。 -->
  <arg name="fx" default="0.0"/>
  <!-- 深度相机 y 方向焦距，深度图输入模式使用。 -->
  <arg name="fy" default="0.0"/>

  <!-- 轨迹最大速度约束，单位为 m/s。 -->
  <arg name="max_vel" default="0.5"/>
  <!-- 轨迹最大加速度约束，单位为 m/s^2。 -->
  <arg name="max_acc" default="3.0"/>
  <!-- 轨迹最大 jerk 约束，单位为 m/s^3。 -->
  <arg name="max_jerk" default="10.0"/>
  <!-- 空间规划前视距离，单位为米。 -->
  <arg name="planning_horizon" default="7.5"/>
  <!-- 时间规划前视窗口，单位为秒。 -->
  <arg name="planning_horizon_time" default="1.0"/>

  <!-- 是否按真实实验方式等待额外启动触发；RViz 选点模式默认不需要。 -->
  <arg name="realworld_experiment" default="false"/>
  <!-- 是否为多机规划使用差异化轨迹。 -->
  <arg name="use_distinctive_trajs" default="true"/>
  <!-- 目标输入模式，1 表示 RViz 手动选点，2 表示预设航点。 -->
  <arg name="flight_type" default="1"/>
  <!-- 是否固定 FSM 与 grid_map 使用的无人机 z 轴高度。 -->
  <arg name="fix_agent_height" default="true"/>
  <!-- FSM 与 grid_map 使用的固定无人机高度，单位为米。 -->
  <arg name="agent_height" default="1.0"/>
  <!-- 是否固定 planner manager 优化输出轨迹的 z 轴高度。 -->
  <arg name="fix_height" default="true"/>
  <!-- planner manager 优化输出轨迹的固定高度，单位为米。 -->
  <arg name="fixed_height" default="1.0"/>
  <!-- 预设航点数量，仅 flight_type=2 时使用。 -->
  <arg name="point_num" default="4"/>
  <!-- 第 0 个预设航点的 x 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point0_x" default="20.0"/>
  <!-- 第 0 个预设航点的 y 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point0_y" default="-9.0"/>
  <!-- 第 0 个预设航点的 z 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point0_z" default="1.0"/>
  <!-- 第 1 个预设航点的 x 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point1_x" default="-20.0"/>
  <!-- 第 1 个预设航点的 y 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point1_y" default="-9.0"/>
  <!-- 第 1 个预设航点的 z 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point1_z" default="1.0"/>
  <!-- 第 2 个预设航点的 x 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point2_x" default="20.0"/>
  <!-- 第 2 个预设航点的 y 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point2_y" default="9.0"/>
  <!-- 第 2 个预设航点的 z 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point2_z" default="1.0"/>
  <!-- 第 3 个预设航点的 x 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point3_x" default="-20.0"/>
  <!-- 第 3 个预设航点的 y 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point3_y" default="9.0"/>
  <!-- 第 3 个预设航点的 z 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point3_z" default="1.0"/>
  <!-- 第 4 个预设航点的 x 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point4_x" default="20.0"/>
  <!-- 第 4 个预设航点的 y 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point4_y" default="-9.0"/>
  <!-- 第 4 个预设航点的 z 坐标，仅 flight_type=2 时使用。 -->
  <arg name="point4_z" default="1.0"/>

  <!-- 栅格地图分辨率，单位为米。 -->
  <arg name="map_resolution" default="0.14"/>
  <!-- 障碍物膨胀距离，单位为米。 -->
  <arg name="obstacles_inflation" default="0.20"/>
  <!-- 局部地图边界保留裕量，单位为米。 -->
  <arg name="local_map_margin" default="1.5"/>
  <!-- 地面高度阈值，低于该高度的点按地面处理。 -->
  <arg name="ground_height" default="0.45"/>
  <!-- 射线投影的最小有效距离，单位为米。 -->
  <arg name="min_ray_length" default="0.3"/>
  <!-- 射线投影的最大有效距离，单位为米。 -->
  <arg name="max_ray_length" default="5.0"/>
  <!-- 地图可视化截断高度，用于限制 RViz 显示范围。 -->
  <arg name="visualization_truncate_height" default="2.0"/>
  <!-- 虚拟天花板高度；小于等于 -0.5 表示关闭，避免在 RViz 中遮挡障碍物点云。 -->
  <arg name="virtual_ceil_height" default="-1.0"/>
  <!-- 位姿输入类型，决定 grid_map 使用 odom、pose 或深度相关输入。 -->
  <arg name="pose_type" default="2"/>
  <!-- B 样条控制点间距，影响轨迹平滑和优化规模。 -->
  <arg name="control_points_distance" default="0.2"/>

  <!-- 预测模块中的动态对象数量。 -->
  <arg name="obj_num" default="10"/>
  <!-- traj_server 在轨迹上向前看的时间，单位为秒。 -->
  <arg name="traj_server_time_forward" default="1.0"/>
  <!-- 是否启动 traj_server，将 bspline 转换为 position_cmd。 -->
  <arg name="enable_traj_server" default="true"/>
  <!-- 完整 planner 话题前缀，由入口 launch 的 agent_name、agent_id、planner_prefix 拼接后传入。 -->
  <arg name="planner_prefix" default=""/>

  <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner_node" type="ego_planner_node" output="screen">
    <!-- 传入 planner 话题前缀，供代码内绝对话题拼接使用。 -->
    <param name="planner_prefix" value="$(arg planner_prefix)"/>

    <!-- 将私有里程计订阅重映射到外部里程计话题。 -->
    <remap from="~odom_world" to="$(arg odom_topic)"/>
    <!-- 将本机 B 样条轨迹发布到带 drone_id 的规划话题。 -->
    <remap from="~planning/bspline" to="$(arg planner_prefix)/drone_$(arg drone_id)_planning/bspline"/>
    <!-- 将规划显示数据发布到带 drone_id 的规划话题。 -->
    <remap from="~planning/data_display" to="$(arg planner_prefix)/drone_$(arg drone_id)_planning/data_display"/>
    <!-- 将本机广播轨迹发布到统一多机广播话题。 -->
    <remap from="~planning/broadcast_bspline_from_planner" to="$(arg planner_prefix)/broadcast_bspline"/>
    <!-- 从统一多机广播话题接收其他 planner 轨迹。 -->
    <remap from="~planning/broadcast_bspline_to_planner" to="$(arg planner_prefix)/broadcast_bspline"/>
    <!-- 将 grid_map 的里程计输入重映射到外部里程计话题。 -->
    <remap from="~grid_map/odom" to="$(arg odom_topic)"/>
    <!-- 将 grid_map 的点云输入重映射到外部点云话题。 -->
    <remap from="~grid_map/cloud" to="$(arg cloud_topic)"/>
    <!-- 将 grid_map 的相机位姿输入重映射到外部位姿话题。 -->
    <remap from="~grid_map/pose" to="$(arg camera_pose_topic)"/>
    <!-- 将 grid_map 的深度图输入重映射到外部深度图话题。 -->
    <remap from="~grid_map/depth" to="$(arg depth_topic)"/>
    <!-- 将 RViz 目标点输入重映射到指定目标话题。 -->
    <remap from="~move_base_simple/goal" to="$(arg goal_name)"/>
    <!-- 将目标点可视化话题纳入 planner 前缀。 -->
    <remap from="~goal_point" to="$(arg planner_prefix)/drone_$(arg drone_id)_ego_planner_node/goal_point"/>
    <!-- 将全局路径可视化话题纳入 planner 前缀。 -->
    <remap from="~global_list" to="$(arg planner_prefix)/drone_$(arg drone_id)_ego_planner_node/global_list"/>
    <!-- 将初始轨迹可视化话题纳入 planner 前缀。 -->
    <remap from="~init_list" to="$(arg planner_prefix)/drone_$(arg drone_id)_ego_planner_node/init_list"/>
    <!-- 将优化轨迹可视化话题纳入 planner 前缀。 -->
    <remap from="~optimal_list" to="$(arg planner_prefix)/drone_$(arg drone_id)_ego_planner_node/optimal_list"/>
    <!-- 将 A* 路径可视化话题纳入 planner 前缀。 -->
    <remap from="~a_star_list" to="$(arg planner_prefix)/drone_$(arg drone_id)_ego_planner_node/a_star_list"/>
    <!-- 将原始占据地图可视化话题纳入 planner 前缀。 -->
    <remap from="~grid_map/occupancy" to="$(arg planner_prefix)/drone_$(arg drone_id)_ego_planner_node/grid_map/occupancy"/>
    <!-- 将膨胀占据地图可视化话题纳入 planner 前缀。 -->
    <remap from="~grid_map/occupancy_inflate" to="$(arg planner_prefix)/drone_$(arg drone_id)_ego_planner_node/grid_map/occupancy_inflate"/>

    <!-- 设置目标输入模式，1 为 RViz 选点，2 为预设航点。 -->
    <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
    <!-- 设置触发重规划的最小时间间隔。 -->
    <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
    <!-- 设置靠近目标时不再重规划的距离阈值。 -->
    <param name="fsm/thresh_no_replan_meter" value="1.0" type="double"/>
    <!-- 设置 FSM 使用的空间规划前视距离。 -->
    <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <!-- 设置 FSM 使用的时间规划前视窗口。 -->
    <param name="fsm/planning_horizen_time" value="$(arg planning_horizon_time)" type="double"/>
    <!-- 设置紧急停止时间阈值。 -->
    <param name="fsm/emergency_time" value="1.0" type="double"/>
    <!-- 设置是否等待真实实验启动触发。 -->
    <param name="fsm/realworld_experiment" value="$(arg realworld_experiment)"/>
    <!-- 设置是否启用 fail-safe 安全逻辑。 -->
    <param name="fsm/fail_safe" value="true"/>
    <!-- 设置是否固定 FSM 和 grid_map 使用的无人机 z 轴高度。 -->
    <param name="fsm/fix_agent_height" value="$(arg fix_agent_height)" type="bool"/>
    <!-- 设置 FSM 和 grid_map 使用的固定无人机高度。 -->
    <param name="fsm/agent_height" value="$(arg agent_height)" type="double"/>

    <!-- 设置预设航点数量，仅 flight_type=2 时使用。 -->
    <param name="fsm/waypoint_num" value="$(arg point_num)" type="int"/>
    <!-- 设置第 0 个预设航点 x 坐标。 -->
    <param name="fsm/waypoint0_x" value="$(arg point0_x)" type="double"/>
    <!-- 设置第 0 个预设航点 y 坐标。 -->
    <param name="fsm/waypoint0_y" value="$(arg point0_y)" type="double"/>
    <!-- 设置第 0 个预设航点 z 坐标。 -->
    <param name="fsm/waypoint0_z" value="$(arg point0_z)" type="double"/>
    <!-- 设置第 1 个预设航点 x 坐标。 -->
    <param name="fsm/waypoint1_x" value="$(arg point1_x)" type="double"/>
    <!-- 设置第 1 个预设航点 y 坐标。 -->
    <param name="fsm/waypoint1_y" value="$(arg point1_y)" type="double"/>
    <!-- 设置第 1 个预设航点 z 坐标。 -->
    <param name="fsm/waypoint1_z" value="$(arg point1_z)" type="double"/>
    <!-- 设置第 2 个预设航点 x 坐标。 -->
    <param name="fsm/waypoint2_x" value="$(arg point2_x)" type="double"/>
    <!-- 设置第 2 个预设航点 y 坐标。 -->
    <param name="fsm/waypoint2_y" value="$(arg point2_y)" type="double"/>
    <!-- 设置第 2 个预设航点 z 坐标。 -->
    <param name="fsm/waypoint2_z" value="$(arg point2_z)" type="double"/>
    <!-- 设置第 3 个预设航点 x 坐标。 -->
    <param name="fsm/waypoint3_x" value="$(arg point3_x)" type="double"/>
    <!-- 设置第 3 个预设航点 y 坐标。 -->
    <param name="fsm/waypoint3_y" value="$(arg point3_y)" type="double"/>
    <!-- 设置第 3 个预设航点 z 坐标。 -->
    <param name="fsm/waypoint3_z" value="$(arg point3_z)" type="double"/>
    <!-- 设置第 4 个预设航点 x 坐标。 -->
    <param name="fsm/waypoint4_x" value="$(arg point4_x)" type="double"/>
    <!-- 设置第 4 个预设航点 y 坐标。 -->
    <param name="fsm/waypoint4_y" value="$(arg point4_y)" type="double"/>
    <!-- 设置第 4 个预设航点 z 坐标。 -->
    <param name="fsm/waypoint4_z" value="$(arg point4_z)" type="double"/>

    <!-- 设置栅格地图分辨率。 -->
    <param name="grid_map/resolution" value="$(arg map_resolution)"/>
    <!-- 设置栅格地图 x 方向范围。 -->
    <param name="grid_map/map_size_x" value="$(arg map_size_x)"/>
    <!-- 设置栅格地图 y 方向范围。 -->
    <param name="grid_map/map_size_y" value="$(arg map_size_y)"/>
    <!-- 设置栅格地图 z 方向范围。 -->
    <param name="grid_map/map_size_z" value="$(arg map_size_z)"/>
    <!-- 设置局部地图 x 方向更新范围。 -->
    <param name="grid_map/local_update_range_x" value="$(arg local_update_range_x)"/>
    <!-- 设置局部地图 y 方向更新范围。 -->
    <param name="grid_map/local_update_range_y" value="$(arg local_update_range_y)"/>
    <!-- 设置局部地图 z 方向更新范围。 -->
    <param name="grid_map/local_update_range_z" value="$(arg local_update_range_z)"/>
    <!-- 设置障碍物膨胀距离。 -->
    <param name="grid_map/obstacles_inflation" value="$(arg obstacles_inflation)"/>
    <!-- 设置局部地图边界裕量。 -->
    <param name="grid_map/local_map_margin" value="$(arg local_map_margin)"/>
    <!-- 设置地面高度过滤阈值。 -->
    <param name="grid_map/ground_height" value="$(arg ground_height)"/>
    <!-- 设置深度相机主点 x 坐标。 -->
    <param name="grid_map/cx" value="$(arg cx)"/>
    <!-- 设置深度相机主点 y 坐标。 -->
    <param name="grid_map/cy" value="$(arg cy)"/>
    <!-- 设置深度相机 x 方向焦距。 -->
    <param name="grid_map/fx" value="$(arg fx)"/>
    <!-- 设置深度相机 y 方向焦距。 -->
    <param name="grid_map/fy" value="$(arg fy)"/>
    <!-- 设置是否启用深度图滤波。 -->
    <param name="grid_map/use_depth_filter" value="true"/>
    <!-- 设置深度滤波容差。 -->
    <param name="grid_map/depth_filter_tolerance" value="0.15"/>
    <!-- 设置深度滤波最大距离。 -->
    <param name="grid_map/depth_filter_maxdist" value="5.0"/>
    <!-- 设置深度滤波最小距离。 -->
    <param name="grid_map/depth_filter_mindist" value="0.2"/>
    <!-- 设置深度滤波边缘剔除像素宽度。 -->
    <param name="grid_map/depth_filter_margin" value="2"/>
    <!-- 设置深度图数值缩放系数。 -->
    <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
    <!-- 设置深度图采样跳步像素数。 -->
    <param name="grid_map/skip_pixel" value="2"/>
    <!-- 设置占据栅格命中概率。 -->
    <param name="grid_map/p_hit" value="0.65"/>
    <!-- 设置占据栅格未命中概率。 -->
    <param name="grid_map/p_miss" value="0.35"/>
    <!-- 设置占据概率下限。 -->
    <param name="grid_map/p_min" value="0.12"/>
    <!-- 设置占据概率上限。 -->
    <param name="grid_map/p_max" value="0.90"/>
    <!-- 设置判定为占据的概率阈值。 -->
    <param name="grid_map/p_occ" value="0.80"/>
    <!-- 设置射线投影最小距离。 -->
    <param name="grid_map/min_ray_length" value="$(arg min_ray_length)"/>
    <!-- 设置射线投影最大距离。 -->
    <param name="grid_map/max_ray_length" value="$(arg max_ray_length)"/>
    <!-- 设置地图可视化截断高度。 -->
    <param name="grid_map/visualization_truncate_height" value="$(arg visualization_truncate_height)"/>
    <!-- 设置虚拟天花板高度；默认关闭，启用时建议高于 visualization_truncate_height。 -->
    <param name="grid_map/virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <!-- 设置是否显示占据更新时间。 -->
    <param name="grid_map/show_occ_time" value="false"/>
    <!-- 设置 grid_map 位姿输入类型。 -->
    <param name="grid_map/pose_type" value="$(arg pose_type)"/>
    <!-- 设置地图坐标系名称。 -->
    <param name="grid_map/frame_id" value="world"/>

    <!-- 设置 planner manager 最大速度。 -->
    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
    <!-- 设置 planner manager 最大加速度。 -->
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <!-- 设置 planner manager 最大 jerk。 -->
    <param name="manager/max_jerk" value="$(arg max_jerk)" type="double"/>
    <!-- 设置 B 样条控制点距离。 -->
    <param name="manager/control_points_distance" value="$(arg control_points_distance)" type="double"/>
    <!-- 设置轨迹可行性检查容差。 -->
    <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
    <!-- 设置 planner manager 规划前视距离。 -->
    <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <!-- 设置是否使用多机差异化轨迹。 -->
    <param name="manager/use_distinctive_trajs" value="$(arg use_distinctive_trajs)" type="bool"/>
    <!-- 设置 planner manager 使用的无人机编号。 -->
    <param name="manager/drone_id" value="$(arg drone_id)"/>
    <!-- 设置是否固定 planner manager 优化输出轨迹的 z 轴高度。 -->
    <param name="manager/fix_height" value="$(arg fix_height)" type="bool"/>
    <!-- 设置 planner manager 优化输出轨迹的固定高度。 -->
    <param name="manager/fixed_height" value="$(arg fixed_height)" type="double"/>

    <!-- 设置平滑项优化权重。 -->
    <param name="optimization/lambda_smooth" value="1.0" type="double"/>
    <!-- 设置碰撞项优化权重。 -->
    <param name="optimization/lambda_collision" value="0.5" type="double"/>
    <!-- 设置可行性项优化权重。 -->
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <!-- 设置轨迹贴合项优化权重。 -->
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <!-- 设置障碍物距离代价的安全距离。 -->
    <param name="optimization/dist0" value="0.5" type="double"/>
    <!-- 设置多机避碰安全距离。 -->
    <param name="optimization/swarm_clearance" value="0.5" type="double"/>
    <!-- 设置优化器速度约束。 -->
    <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
    <!-- 设置优化器加速度约束。 -->
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>

    <!-- 设置 B 样条速度限制。 -->
    <param name="bspline/limit_vel" value="$(arg max_vel)" type="double"/>
    <!-- 设置 B 样条加速度限制。 -->
    <param name="bspline/limit_acc" value="$(arg max_acc)" type="double"/>
    <!-- 设置 B 样条约束冗余比例。 -->
    <param name="bspline/limit_ratio" value="1.1" type="double"/>

    <!-- 设置预测模块动态对象数量。 -->
    <param name="prediction/obj_num" value="$(arg obj_num)" type="int"/>
    <!-- 设置预测模块 lambda 参数。 -->
    <param name="prediction/lambda" value="1.0" type="double"/>
    <!-- 设置预测模块预测频率。 -->
    <param name="prediction/predict_rate" value="1.0" type="double"/>
  </node>

  <node if="$(arg enable_traj_server)" pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
    <!-- 传入 planner 话题前缀，供 traj_server 发布 position_cmd 使用。 -->
    <param name="planner_prefix" value="$(arg planner_prefix)"/>
    <!-- 将 traj_server 的 B 样条输入重映射到 planner 输出轨迹。 -->
    <remap from="~planning/bspline" to="$(arg planner_prefix)/drone_$(arg drone_id)_planning/bspline"/>
    <!-- 设置 traj_server 生成控制命令时的前视时间。 -->
    <param name="traj_server/time_forward" value="$(arg traj_server_time_forward)" type="double"/>
  </node>
</launch>
