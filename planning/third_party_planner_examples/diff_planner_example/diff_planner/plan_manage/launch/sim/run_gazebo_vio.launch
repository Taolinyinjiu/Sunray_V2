<launch>
  <!-- Gazebo 单机深度模式入口。 -->
  <arg name="uav_id" default="1"/>
  <!-- Diff Planner 内部使用的编号。 -->
  <arg name="drone_id" default="0"/>
  <arg name="map_size_x" default="45.0"/>
  <arg name="map_size_y" default="45.0"/>
  <arg name="map_size_z" default="5.0"/>
  <!-- Gazebo 位姿输入。 -->
  <arg name="odom_topic" default="/uav$(arg uav_id)/sunray/gazebo_pose"/>
  <!-- 深度图输入。 -->
  <arg name="depth_topic" default="/camera/depth/image_rect_raw"/>
  <!-- 规划器输出的位置指令。 -->
  <arg name="position_cmd_topic" default="/uav$(arg uav_id)/pos_cmd"/>
  <!-- 规划器动力学约束。 -->
  <arg name="max_vel" default="0.5"/>
  <arg name="max_acc" default="3.0"/>
  <arg name="max_jer" default="20.0"/>
  <arg name="planning_horizon" default="7.5"/>
  <!-- true 时 FSM 会等待额外触发；false 时收到目标即可规划。 -->
  <arg name="require_start_trigger" default="false"/>
  <!-- 是否固定用于地图更新和 FSM 判定的飞行高度。 -->
  <arg name="fix_agent_height" default="true"/>
  <arg name="agent_height" default="1.0"/>
  <!-- 是否固定输出轨迹高度。 -->
  <arg name="fix_height" default="true"/>
  <arg name="fixed_height" default="1.0"/>
  <!-- false 为 360 度显示点云/地图；true 为只显示机头前方约 60 度。 -->
  <arg name="front_vis" default="false"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="enable_diff_adapter" default="true"/>
  <arg name="control_cmd_topic" default="/uav$(arg uav_id)/sunray/uav_control/control_cmd"/>
  <arg name="use_yaw_rate" default="false"/>
  <arg name="ready_only" default="true"/>

  <!-- Gazebo + 深度入口：使用里程计 + 深度图，不接入点云。 -->
  <include file="$(find diff_planner)/launch/include/advanced_param.xml">
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="camera_pose_topic" value="no_use0"/>
    <arg name="depth_topic" value="$(arg depth_topic)"/>
    <arg name="cloud_topic" value="no_use2"/>
    <arg name="position_cmd_topic" value="$(arg position_cmd_topic)"/>
    <arg name="cx" value="322.0597839355469"/>
    <arg name="cy" value="235.91989135742188"/>
    <arg name="fx" value="390.4934997558594"/>
    <arg name="fy" value="390.4934997558594"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="max_jer" value="$(arg max_jer)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="local_map_size_x" value="5.5"/>
    <arg name="local_map_size_y" value="5.5"/>
    <arg name="local_map_size_z" value="2.0"/>
    <arg name="enable_virtual_wall" value="true"/>
    <arg name="virtual_ceil" value="2.0"/>
    <arg name="virtual_ground" value="0.1"/>
    <arg name="map_resolution" value="0.15"/>
    <arg name="inflation_size" value="0.2"/>
    <arg name="front_vis" value="$(arg front_vis)"/>
    <arg name="init_x" value="0.0"/>
    <arg name="init_y" value="0.0"/>
    <arg name="init_z" value="0.0"/>
    <arg name="fix_agent_height" value="$(arg fix_agent_height)"/>
    <arg name="agent_height" value="$(arg agent_height)"/>
    <arg name="fix_height" value="$(arg fix_height)"/>
    <arg name="fixed_height" value="$(arg fixed_height)"/>
    <arg name="flight_type" value="1"/>
    <arg name="require_start_trigger" value="$(arg require_start_trigger)"/>
    <arg name="point_num" value="1"/>
    <arg name="point0_x" value="3.0"/>
    <arg name="point0_y" value="0.0"/>
    <arg name="point0_z" value="1.0"/>
  </include>

  <!-- 将 Diff Planner 的 pos_cmd 转成 Sunray 控制命令。 -->
  <include if="$(arg enable_diff_adapter)" file="$(find sunray_diff_adapter)/launch/Diff2Sunray.launch">
    <arg name="agent_name" value="uav"/>
    <arg name="agent_id" value="$(arg uav_id)"/>
    <arg name="input_topic" value="$(arg position_cmd_topic)"/>
    <arg name="output_topic" value="$(arg control_cmd_topic)"/>
    <arg name="use_yaw_rate" value="$(arg use_yaw_rate)"/>
    <arg name="ready_only" value="$(arg ready_only)"/>
  </include>

  <!-- 使用精简后的单机 RViz 配置。 -->
  <node if="$(arg enable_rviz)"
        name="rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(find diff_planner)/launch/rviz_config/single.rviz"
        required="true" />
</launch>
