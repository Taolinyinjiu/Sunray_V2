<?xml version="1.0"?>
<package format="2">
  <name>sunray_super_adapter</name>
  <version>0.0.0</version>
  <description>SUPER planner to Sunray control command adapter.</description>

  <maintainer email="taolin@todo.todo">taolin</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>planner_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sunray_msgs</build_depend>

  <build_export_depend>planner_msgs</build_export_depend>
