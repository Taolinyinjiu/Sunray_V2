<launch>
  <!-- MOVE_VELOCITY/circle_velocity.cpp 启动入口 -->
  <!-- 安全边界：默认半径 1.0m、切向速度约 0.2m/s、速度限幅 0.5m/s，完成后 RETURN；依赖 local_odom。 -->
  <!-- 默认 use_private_agent_key=false 时读取全局 /agent_name 和 /agent_id；设为 true 时读取本 launch 参数。 -->
  <arg name="agent_name" default="uav" />
  <arg name="agent_id" default="1" />
  <arg name="node_name" default="circle_velocity_node" />
  <arg name="use_private_agent_key" default="false" />

  <node pkg="sunray_uav_control_example"
        type="circle_velocity_node"
        name="$(arg node_name)"
        output="screen">
    <param name="agent_name" type="str" value="$(arg agent_name)" />
    <param name="agent_id" type="int" value="$(arg agent_id)" />
    <param name="use_private_agent_key" type="bool" value="$(arg use_private_agent_key)" />
  </node>
</launch>
