<launch>
  <!-- agent_name、agent_id 与 planner_prefix 共同组成完整 planner 前缀 -->
	<!-- /<agent_name><agent_id><planner_prefix>，例如 /uav1/sunray/planning/ego_planner。  -->
  <arg name="agent_name" default="uav"/>
  <arg name="agent_id" default="1"/>
  <arg name="planner_prefix" default="/sunray/uav_planning_example/ego_planner"/>

  <!-- 无人机编号，传递给 EGO planner 的 drone_id。 -->
  <arg name="drone_id" default="0"/>
  <!-- 地图 x 方向尺寸，单位为米。 -->
  <arg name="map_size_x" default="50.0"/>
  <!-- 地图 y 方向尺寸，单位为米。 -->
  <arg name="map_size_y" default="25.0"/>
  <!-- 地图 z 方向尺寸，单位为米。 -->
  <arg name="map_size_z" default="2.0"/>
  <!-- 定位融合 local_odom 输入话题，默认由 agent_name 与 agent_id 拼接。 -->
  <arg name="odom_topic" default="/$(arg agent_name)$(arg agent_id)/sunray/localization/local_odom"/>
  <!-- LIO 点云输入话题。 -->
  <arg name="cloud_topic" default="/velodyne_points"/>
  <!-- 最大飞行速度，单位为 m/s。 -->
  <arg name="max_vel" default="0.5"/>
  <!-- 最大飞行加速度，单位为 m/s^2。 -->
  <arg name="max_acc" default="3.0"/>
  <!-- 最大飞行 jerk，单位为 m/s^3。 -->
  <arg name="max_jerk" default="10.0"/>
  <!-- 规划前视距离，单位为米。 -->
  <arg name="planning_horizon" default="7.5"/>
  <!-- 规划前视时间，单位为秒。 -->
  <arg name="planning_horizon_time" default="1.0"/>
  <!-- 是否等待真实实验触发；RViz 选点默认不等待。 -->
  <arg name="realworld_experiment" default="false"/>
  <!-- 是否启用多机差异化轨迹。 -->
  <arg name="use_distinctive_trajs" default="true"/>
  <!-- 目标输入模式，1 表示 RViz 选点。 -->
  <arg name="flight_type" default="1"/>
  <!-- 是否固定 FSM 与 grid_map 使用的无人机 z 轴高度。 -->
  <arg name="fix_agent_height" default="true"/>
  <!-- FSM 与 grid_map 使用的固定无人机高度，单位为米。 -->
  <arg name="agent_height" default="1.0"/>
  <!-- 是否固定 planner manager 优化输出轨迹的 z 轴高度。 -->
  <arg name="fix_height" default="true"/>
  <!-- planner manager 优化输出轨迹的固定高度，单位为米。 -->
  <arg name="fixed_height" default="1.0"/>
  <!-- 虚拟天花板高度；小于等于 -0.5 表示关闭，避免在 RViz 中遮挡障碍物点云。 -->
  <arg name="virtual_ceil_height" default="-1.0"/>
  <!-- 是否启动 RViz。 -->
  <arg name="enable_rviz" default="true"/>

  <include file="$(find ego_planner)/launch/include/advanced_param.xml">
    <!-- 将本 launch 的场景参数透传给统一高级参数文件。 -->
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="max_jerk" value="$(arg max_jerk)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="planning_horizon_time" value="$(arg planning_horizon_time)"/>
    <arg name="realworld_experiment" value="$(arg realworld_experiment)"/>
    <arg name="use_distinctive_trajs" value="$(arg use_distinctive_trajs)"/>
    <arg name="flight_type" value="$(arg flight_type)"/>
    <arg name="fix_agent_height" value="$(arg fix_agent_height)"/>
    <arg name="agent_height" value="$(arg agent_height)"/>
    <arg name="fix_height" value="$(arg fix_height)"/>
    <arg name="fixed_height" value="$(arg fixed_height)"/>
    <arg name="virtual_ceil_height" value="$(arg virtual_ceil_height)"/>
    <!-- 指定 RViz 选点目标话题。 -->
    <arg name="goal_name" value="/move_base_simple/goal"/>
    <arg name="planner_prefix" value="/$(arg agent_name)$(arg agent_id)$(arg planner_prefix)"/>
  </include>

  <!-- 启动 RViz，并加载单机规划显示配置。 -->
  <node if="$(arg enable_rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(find ego_planner)/launch/rviz_config/single.rviz" required="true" />

  <include file="$(find ego_example)/launch/Ego2Sunray.launch">
    <!-- 将当前示例的无人机标识传递给 Ego2Sunray，用于拼接输入和输出话题。 -->
    <arg name="agent_name" value="$(arg agent_name)"/>
    <arg name="agent_id" value="$(arg agent_id)"/>
    <arg name="planner_prefix" value="$(arg planner_prefix)"/>
  </include>
</launch>
